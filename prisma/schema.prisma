// JoeOS core schema — Lead CRM + inventory mirror of dealership feed.
// Public brand: Joe's Used Harleys. Internal platform: JoeOS.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum BikeStatus {
  AVAILABLE
  PENDING
  SOLD
}

enum BikeSource {
  FEED
  MANUAL
}

enum InteractionType {
  PHONE_CALL
  TEXT
  VISIT
  EMAIL
  TEST_RIDE
}

enum SyncTrigger {
  CRON
  MANUAL
  DRY_RUN
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model Lead {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  source       String?
  status       LeadStatus    @default(NEW)
  notes        String?
  createdAt    DateTime      @default(now())
  interactions Interaction[]

  @@index([status])
  @@index([createdAt])
}

model Bike {
  id String @id @default(cuid())

  // --- Dealership-owned (JoeOS sync may write) ---
  source         BikeSource @default(MANUAL)
  feedId         String?
  vin            String?    @unique
  stockNumber    String?
  year           Int
  make           String
  model          String
  title          String?
  price          Int?
  mileage        Int?
  color          String?
  description    String?
  condition      String?
  category       String?
  transmission   String?
  certified      String?
  vrm            String?
  listPriceRaw   String?
  inventoryUrl   String?
  locationId     String?
  locationName   String?
  city           String?
  state          String?
  zipcode        String?
  dealerPhone    String?
  dealerEmail    String?
  photos         String[]   @default([])
  dealerHash     String?
  status         BikeStatus @default(AVAILABLE)
  firstSeenAt    DateTime   @default(now())
  lastSeenAt     DateTime   @default(now())
  soldAt         DateTime?
  syncedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // --- Joe-owned (sync never writes) ---
  featuredRank         Int      @default(0)
  hidden               Boolean  @default(false)
  joeRating            Int?
  perfectFor           String?
  favoriteFeature      String?
  idealRider           String?
  thingsToMention      String?
  thingsToCheck        String?
  whyIDLikeIt          String?
  whoShouldSkipIt      String?
  conversationStarter  String?
  walkaroundVideoUrl   String?
  faq                  Json?
  buyingTips           String?
  seoHeadline          String?
  seoDescription       String?
  personalPhotos       String[] @default([])
  personalHeroImageUrl String?
  internalNotes        String?

  priceHistory BikePriceHistory[]
  analytics    BikeAnalytics?

  @@index([stockNumber])
  @@index([status, hidden])
  @@index([make, model])
  @@index([lastSeenAt])
  @@index([featuredRank, status])
  @@index([firstSeenAt])
  @@index([soldAt])
  @@index([source])
}

model BikePriceHistory {
  id            String   @id @default(cuid())
  bikeId        String
  bike          Bike     @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  vin           String?
  previousPrice Int?
  newPrice      Int?
  changedAt     DateTime @default(now())
  syncLogId     String?
  syncLog       SyncLog? @relation(fields: [syncLogId], references: [id], onDelete: SetNull)

  @@index([bikeId, changedAt])
  @@index([vin, changedAt])
  @@index([changedAt])
}

model SyncLog {
  id               String      @id @default(cuid())
  startedAt        DateTime
  finishedAt       DateTime?
  durationMs       Int?
  trigger          SyncTrigger
  status           SyncStatus
  feedUrl          String
  feedVersion      String?
  fetchedBytes     Int?
  parsedCount      Int?
  usedHarleyCount  Int?
  createdCount     Int         @default(0)
  updatedCount     Int         @default(0)
  soldCount        Int         @default(0)
  unchangedCount   Int         @default(0)
  priceChangeCount Int         @default(0)
  errorCount       Int         @default(0)
  errors           Json?
  dryRun           Boolean     @default(false)
  createdAt        DateTime    @default(now())

  priceHistory BikePriceHistory[]

  @@index([startedAt])
  @@index([status])
}

model BikeAnalytics {
  id                  String    @id @default(cuid())
  bikeId              String    @unique
  bike                Bike      @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  views               Int       @default(0)
  favorites           Int       @default(0)
  emails              Int       @default(0)
  texts               Int       @default(0)
  calls               Int       @default(0)
  shares              Int       @default(0)
  walkaroundRequests  Int       @default(0)
  testRideRequests    Int       @default(0)
  uniqueVisitors      Int       @default(0)
  impressions         Int       @default(0)
  contactClicks       Int       @default(0)
  financingOpens      Int       @default(0)
  searchHits          Int       @default(0)
  avgTimeOnPageMs     Int       @default(0)
  timeOnPageSamples   Int       @default(0)
  lastViewedAt        DateTime?
  lastDetailViewAt    DateTime?
  updatedAt           DateTime  @updatedAt
}

enum AnalyticsEventType {
  PAGE_VIEW
  BIKE_DETAIL_VIEW
  INVENTORY_IMPRESSION
  SEARCH_QUERY
  FILTER_USAGE
  TIME_ON_PAGE
  CONTACT_CLICK
  FINANCING_OPEN
  FAVORITE
  SHARE_CLICK
  APPOINTMENT_REQUEST
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  bikeId    String?
  sessionId String
  path      String?
  query     String?
  filters   Json?
  meta      Json?
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([bikeId, type, createdAt])
  @@index([sessionId, createdAt])
}

model Interaction {
  id        String          @id @default(cuid())
  leadId    String
  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      InteractionType
  note      String?
  createdAt DateTime        @default(now())

  @@index([leadId])
  @@index([createdAt])
}

enum SeoUrlType {
  STATIC
  GUIDE
  MODEL
  MODEL_YEAR
  FAMILY
  COLOR
  ENGINE
  COMPARE
  CITY
  CITY_MODEL
  CITY_MODEL_YEAR
  ROUTE
  EVENT
  INVENTORY
  HUB
}

enum SeoStatus {
  DRAFT
  NOINDEX
  INDEX
}

model SeoUrl {
  id            String     @id @default(cuid())
  path          String     @unique
  type          SeoUrlType
  status        SeoStatus  @default(DRAFT)
  score         Int        @default(0)
  scoreDetail   Json?
  lastModified  DateTime   @updatedAt
  lastIndexedAt DateTime?
  indexNowAt    DateTime?
  payload       Json?
  createdAt     DateTime   @default(now())

  @@index([status, type])
  @@index([type])
}

model SeoIndexPing {
  id        String   @id @default(cuid())
  path      String
  provider  String
  ok        Boolean
  response  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

enum KnowledgeEntityType {
  MODEL
  FAMILY
  GENERATION
  ENGINE
  TRIM
  COLOR
  RIDING_STYLE
  BUYER_PERSONA
  BUYING_TOPIC
  OWNERSHIP_TOPIC
  MAINTENANCE_TOPIC
  UPGRADE_TOPIC
  COMPARISON
  FINANCING_TOPIC
  INSURANCE_TOPIC
  ROUTE
  CITY
  EVENT
}

enum KnowledgeStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeRelationKind {
  IN_FAMILY
  USES_ENGINE
  HAS_GENERATION
  HAS_TRIM
  SUITS_PERSONA
  SUITS_STYLE
  TOPIC_OF
  COMPARES
  NEAR_CITY
  RELATED_GUIDE
  SHOWS_INVENTORY_HINT
  RELATED_TO
}

model KnowledgeEntity {
  id             String              @id @default(cuid())
  type           KnowledgeEntityType
  slug           String
  title          String
  status         KnowledgeStatus     @default(DRAFT)
  summary        String              @default("")
  facts          Json                @default("{}")
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  relationsFrom  KnowledgeRelation[] @relation("RelationFrom")
  relationsTo    KnowledgeRelation[] @relation("RelationTo")
  revisions      KnowledgeRevision[]

  @@unique([type, slug])
  @@index([type, status])
  @@index([status])
}

model KnowledgeRelation {
  id     String                @id @default(cuid())
  fromId String
  toId   String
  from   KnowledgeEntity       @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     KnowledgeEntity       @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)
  kind   KnowledgeRelationKind
  label  String?
  weight Int                   @default(0)

  @@unique([fromId, toId, kind])
  @@index([fromId, kind])
  @@index([toId, kind])
}

model KnowledgeRevision {
  id        String          @id @default(cuid())
  entityId  String
  entity    KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  snapshot  Json
  note      String?
  actorId   String?
  createdAt DateTime        @default(now())

  @@index([entityId, createdAt])
}
